{
  "name": "bkk-analytics-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npx @opennextjs/cloudflare build --skipNextBuild",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "smoke:interactive-panels": "node scripts/smoke-interactive-panels.mjs",
    "smoke:interactive-panels:offline": "node scripts/smoke-interactive-panels.mjs --allow-data-unavailable",
    "observatory:boundaries": "node scripts/observatory/extract-provisional-boundaries.mjs",
    "observatory:authorization": "node scripts/observatory/validate-boundary-authorization.mjs",
    "observatory:authorization:require-approved": "node scripts/observatory/validate-boundary-authorization.mjs --require-approved",
    "observatory:contracts": "node scripts/observatory/test-contracts.mjs",
    "observatory:intake-boundary": "node scripts/observatory/intake-bma-boundary.mjs --write-report",
    "observatory:intake-sentinel": "node scripts/observatory/intake-sentinel-2.mjs --write-report",
    "observatory:inspect-boundary": "node scripts/observatory/inspect-bma-boundary.mjs --write-report",
    "observatory:ndvi:exhaustive-plan": "node scripts/observatory/plan-ndvi-exhaustive-qa.mjs --write-report",
    "observatory:ndvi:exhaustive-report": "node scripts/observatory/summarize-ndvi-exhaustive-qa.mjs --write-report",
    "observatory:ndvi:exhaustive-worker": "node scripts/observatory/run-ndvi-exhaustive-worker.mjs",
    "observatory:ndvi:field-qa": "node scripts/observatory/run-ndvi-field-qa.mjs --write-report",
    "observatory:recipes": "node scripts/observatory/test-ndvi-recipe.mjs --write-report",
    "observatory:supabase:check": "node scripts/observatory/check-supabase-public.mjs",
    "observatory:supabase:plan": "node scripts/observatory/sync-supabase-registry.mjs",
    "observatory:supabase:seed-ndvi-qa": "node scripts/observatory/seed-ndvi-field-qa-run.mjs --apply",
    "observatory:supabase:queue-ndvi-exhaustive": "node scripts/observatory/queue-ndvi-exhaustive-qa.mjs --apply",
    "observatory:supabase:seed-boundary-authorization": "node scripts/observatory/seed-boundary-authorization.mjs --apply",
    "observatory:supabase:seed-sentinel": "node scripts/observatory/seed-sentinel-version.mjs --apply",
    "observatory:supabase:sync": "node scripts/observatory/sync-supabase-registry.mjs --apply",
    "observatory:validate": "node scripts/observatory/validate-registry.mjs",
    "lint:observatory": "eslint \"scripts/observatory/**/*.mjs\" \"src/app/api/v1/**/*.ts\" \"src/app/areas/**/*.tsx\" \"src/app/evidence/**/*.tsx\" \"src/app/observatory/**/*.tsx\" \"src/components/observatory/**/*.tsx\" \"src/lib/observatory/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "accessibility:update": "node scripts/update-accessibility-data.mjs",
    "gee:air-pollution": "node scripts/gee/run-air-pollution.mjs",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.0",
    "@google/earthengine": "^1.7.25",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.104.0",
    "@turf/turf": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.8.0",
    "next": "^15.5.15",
    "node-fetch": "^3.3.2",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@opennextjs/cloudflare": "^1.19.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.15",
    "fast-xml-parser": "^5.10.1",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "proj4": "^2.21.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.87.0"
  }
}
